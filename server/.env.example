# Claude Bridge 配置（复制为 .env 后按需修改）

# 监听端口（ClawTalk → OpenClaw → 本桥）
CLAUDE_BRIDGE_PORT=18791

# 桥的 Bearer token（建议与 OpenClaw 网关 token 一致，或不设）
CLAUDE_BRIDGE_TOKEN=

# Claude 模型
CLAUDE_MODEL=claude-sonnet-4-6

# 方式一：Anthropic API（推荐，稳定）
# 填入 sk-ant- 开头的 key 即走 API
ANTHROPIC_API_KEY=

# 方式二：本地 claude CLI（需已登录）
# CLAUDE_CLI_PATH=claude
