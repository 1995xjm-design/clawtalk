    "API Mode": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 模式"
          }
        }
      }
    },
    "API keys and tokens are stored in the iOS Keychain, encrypted at rest. Voice is transcribed on-device — audio never leaves your phone. Agent communication uses HTTPS.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥和令牌存储在 iOS 钥匙串中并加密保存。语音在设备端转写——音频不会离开你的手机。智能体通信使用 HTTPS。"
          }
        }
      }
    },
