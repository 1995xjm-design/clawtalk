    "Chat history is stored locally on this device with iOS Data Protection (encrypted at rest).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天记录通过 iOS 数据保护存储在本机（静止时加密）。"
          }
        }
      }
    },
    "Chat with your OpenClaw AI agents.\nType, send images, or talk hands-free.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与你的 OpenClaw AI 智能体聊天。\n输入文字、发送图片，或免提语音对话。"
          }
        }
      }
    },
