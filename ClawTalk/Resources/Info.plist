<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ClawTalk</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>当 AI 助手需要查看或创建日程时，需要访问你的日历。</string>
	<key>NSCameraUsageDescription</key>
	<string>当 AI 助手需要拍照或录制视频时，需要访问你的相机。</string>
	<key>NSContactsUsageDescription</key>
	<string>当 AI 助手需要查找或添加联系人时，需要访问你的通讯录。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>在你授权时共享位置，用于到家/离家提醒、出行记录与附近地点查询。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>需要麦克风权限，用于向 AI 助手发送语音消息和语音指令。</string>
	<key>NSMotionUsageDescription</key>
	<string>当 AI 助手需要了解活动或步数信息时，需要访问运动数据。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>当 AI 助手需要获取图片时，需要访问你的照片。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>当 AI 助手需要查看或创建提醒事项时，需要访问你的提醒事项。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>使用语音识别把你的语音消息转写成文字，供 AI 助手理解。</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>用于接收 AI 助手的提醒、配对结果与推送通知。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>用于到家/离家提醒与出行记录，需要在后台也能获取你的位置。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于连接同一局域网内的电脑，进行文件传输与记忆同步。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于保存微信连接二维码图片到相册</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.openclaw.clawtalk.bgrefresh</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>读取健康数据（步数），以便 AI 助手为你提供健康相关提醒与信息。</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.openclaw.clawtalk</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clawtalk</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
</dict>
</plist>
